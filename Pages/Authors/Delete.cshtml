@page "{id:int}"
@model Kellner_Lorand_Lab2.Pages.Authors.DeleteModel

<h1>Delete Author</h1>

<h3>Are you sure you want to delete this author?</h3>

<hr />

<dl class="row">
    <dt class="col-sm-2">First Name</dt>
    <dd class="col-sm-10">@Model.Author.FirstName</dd>

    <dt class="col-sm-2">Last Name</dt>
    <dd class="col-sm-10">@Model.Author.LastName</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Author.ID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="./Index">Back to List</a>
</form>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>