@page
@model Kellner_Lorand_Lab2.Pages.Authors.IndexModel

<h1>Authors</h1>

<p>
    <a asp-page="Create">Create New</a>
 
</p>

<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var author in Model.Authors)
        {
            <tr>

                <td>@author.FirstName</td>
                <td>@author.LastName</td>
                <a asp-page="Edit" asp-route-id="@author.ID">Edit</a> |
<a asp-page="Details" asp-route-id="@author.ID">Details</a> |
<a asp-page="Delete" asp-route-id="@author.ID">Delete</a>
            </tr>
        }
    </tbody>
</table>