@page "{id:int}"
@model Kellner_Lorand_Lab2.Pages.Publishers.DeleteModel

<h1>Delete Publisher</h1>

<h3>Are you sure you want to delete this publisher?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Publisher.PublisherName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Publisher.PublisherName)</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Publisher.ID" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index">Back to List</a>
    </form>
</div>